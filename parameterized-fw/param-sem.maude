load components-impl.maude

***
*** Provided by the user (for each language)
***

fmod LANGUAGE is
	extending LANGUAGE-INFRASTRUCTURE .
	protecting EXPRESSION .
	protecting INT .
	protecting QID .

	sort Inst .
	sort Var .
	subsort Var < Reference .
	*** Lenguaje al que se le da semántica
	op var : Qid -> Var [ctor] .

	op _ := _ ; : Var IExp -> Inst [ctor prec 20] .
    op _ := _ ; : Var BExp -> Inst [ctor prec 20] .
    op _ := _ ; : Var RExp -> Inst [ctor prec 20] .
endfm

view Inst from TRIV to LANGUAGE is
	sort Elt to Inst .
endv
view Reference from TRIV to LANGUAGE is
	sort Elt to Reference .
endv

*** Dummy module to generate views
fmod FORMAL-TYPES{X :: SEMANTIC-TYPES} is
endfm

view BVal{X :: SEMANTIC-TYPES} from TRIV to FORMAL-TYPES{X} is
	sort Elt to X$BVal .
endv
view IVal{X :: SEMANTIC-TYPES} from TRIV to FORMAL-TYPES{X} is
	sort Elt to X$IVal .
endv
view RVal{X :: SEMANTIC-TYPES} from TRIV to FORMAL-TYPES{X} is
	sort Elt to X$RVal .
endv

fmod SEMANTIC-STATE{X :: SEMANTIC-TYPES} is
	*** R: Defines full S_{fw,v}
	protecting LANGUAGE .
	extending INFRASTRUCTURE .

	protecting MAP{Qid, BVal{X}} * (sort Map{Qid, BVal{X}} to BStore) * (op _|->_ to _|->B_ ) .
	protecting MAP{Qid, IVal{X}} * (sort Map{Qid, IVal{X}} to IStore) * (op _|->_ to _|->I_ ) .
	protecting MAP{Qid, RVal{X}} * (sort Map{Qid, RVal{X}} to RStore) * (op _|->_ to _|->R_ ) .

	protecting LIST{Inst} * (sort List{Inst} to Program) .

    op if _ then {_} else {_} : BExp Program Program -> Inst [ctor prec 20] .
    op if _ then {_} : BExp Program -> Inst [prec 20] .

    op while _ do {_} : BExp Program -> Inst [ctor prec 20] .

	sort Store .

	*** Operadores que definen el estado de la semántica y funciones auxiliares
	op bresolve : Reference State -> X$BVal .
	op iresolve : Reference State -> X$IVal .
	op rresolve : Reference State -> X$RVal .

	*** Program
	op _|_|_ : BStore IStore RStore -> Store [ctor] .
	op <_|_> : Program Store -> State [ctor] .

	eq bresolve(var(Q:Qid), < P:Program | (BSTR:BStore | ISTR:IStore | RSTR:RStore ) >) = BSTR:BStore[Q:Qid] .
	eq iresolve(var(Q:Qid), < P:Program | (BSTR:BStore | ISTR:IStore | RSTR:RStore ) >) = ISTR:IStore[Q:Qid] .
	eq rresolve(var(Q:Qid), < P:Program | (BSTR:BStore | ISTR:IStore | RSTR:RStore ) >) = RSTR:RStore[Q:Qid] .
endfm

mod SEMANTIC-RULES{X :: SEMANTIC-EVAL} is
	*** R: Generic definition of semantic rules (R_v), and import S_{fw,v}
	*** NOTE: For narrowing use SemanticTypesNoRat instead of SemanticTypes
	protecting SEMANTIC-STATE{SemanticTypes}{X} .
	*** Reglas de la semántica (usando eval de X)
	vars P P1 P2 : Program .
	var V : Var . var Q : Qid .
	var IExp : IExp . var BExp : BExp . var RExp : RExp .
	var ISTR : IStore . var BSTR : BStore . var RSTR : RStore .
	var STR : Store .

	*** rew in SEMANTIC-SI1 : < var('x) := (val(2) + val(3)) ; var('y) := val(true) ; | (empty | empty | empty)  > .
	*** rew in SEMANTIC-SI2 : < var('x) := (val(2) + val(3)) ; var('y) := iref(var('x)) ; | (empty | empty | empty)  > .
	*** rew in SEMANTIC-SI2 : < var('x) := (val(2) + val(3)) ; var('y) := iref(var('x)) ; if (var('x) = var('y)) then {var('z) := val(true) ;} else {var('z) := val(false) ; } | (empty | empty | empty)  > .
	*** rew in SEMANTIC-SI1 : < var('x) := (val(2) + val(3)) ; var('y) := iref(var('x)) ; if (val(5) = val(5)) then {var('z) := val(true) ;} else {var('z) := val(false) ; } | (empty | empty | empty)  > .
	*** rew in SEMANTIC-SI1 : < var('x) := (val(2) + val(3)) ; var('y) := iref(var('x)) ; if (iref(var('x)) = iref(var('y))) then {var('z) := val(true) ;} else {var('z) := val(false) ; } | (empty | empty | empty)  > .
	*** MaudeSE> smt-search [1] < var('x) := (val(2) + val(3)) ; var('y) := iref(var('x)) ; if (iref(var('x)) = iref(var('y))) then {var('z) := val((true).Bool) ;} else {var('z) := val((false).Bool) ; } | (empty | empty | empty) > =>* S:State such that (true).Boolean using QF_LRA .
	*** smt-search [1] < var('x) := (val(2) + val(3)) ; | (empty | empty | empty) > =>* S:State such that (true).Boolean using QF_LRA .
	*** vu-narrow {delay, filter} in SEMANTIC-SI3 : < var('x) := (val(2) + val(3)) ; var('y) := iref(var('x)) ; if (val(5) > val(5)) then {var('z) := val((true).Bool) ;} else {var('z) := val((false).Bool) ; } | (empty | empty | empty) > =>* S:State .
	*** vu-narrow {delay, filter} < var('x) := (val(2) + val(3)) ; var('y) := iref(var('x)) ; if (val(5) > val(5)) then {var('z) := val((true).Bool) ;} else {var('z) := val((false).Bool) ; } | (empty | empty | empty) > =>* S:State .
	*** search in SEMANTIC-SI3 : < var('x) := (val(2) + val(3)) ; var('y) := iref(var('x)) ; if (val(5) > val(5)) then {var('z) := val((true).Bool) ;} else {var('z) := val((false).Bool) ; } | (empty | empty | empty) > =>* S:State .
	rl [assign-B] : < var(Q) := BExp ; P | (BSTR | ISTR | RSTR) > 
					=> 
					< P | (insert(Q, eval(BExp, < nil | (BSTR | ISTR | RSTR) >), BSTR) | ISTR | RSTR) > .
	rl [assign-I] : < var(Q) := IExp ; P | (BSTR | ISTR | RSTR) > 
					=> 
					< P | (BSTR | insert(Q, eval(IExp, < nil | (BSTR | ISTR | RSTR) >), ISTR) | RSTR) > .
	rl [assign-R] : < var(Q) := RExp ; P | (BSTR | ISTR | RSTR) > 
					=> 
					< P | (BSTR | ISTR | insert(Q, eval(RExp, < nil | (BSTR | ISTR | RSTR) >), RSTR)) > .

	*** NOTE: The condition is type BVal...
	*** TODO: How to include metaCheck and [narrowing]?? -> Transformation
    crl [if-then] : 
        < if BExp then { P1 } else { P2 } P | STR >
        =>
        < P1 P | STR >
        if eval(BExp, < nil | STR >) = tt .

    crl [if-else] : 
        < if BExp then { P1 } else { P2 } P | STR >
        =>
        < P2 P | STR >
        if (not eval(BExp, < nil | STR >)) = tt .
    *** R: Moved here from below but maybe bettwer below...
	*** Extiende ecuacionalmente la función de evaluación
	
	***eq eval(iref(R:Reference), S:State) = iresolve(R:Reference, S:State) .
endm

