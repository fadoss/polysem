mod SEMANTIC-SI2' is
	***NOTE: Kind of IValS is RValS?
	--- * (op _`[_`] : BStore Qid -> [Boolean] to _`[_`]S)
	--- * (op _`[_`] : IStore Qid -> [RValS] to _`[_`]S)
	--- * (op _`[_`] : RStore Qid -> [RValS] to _`[_`]S)

	*** NOTE: We need (sort Store to StoreS) to distinguish STR:Store concrete and symbolic variables!!!
	***		  - Do this for each Struct!!
	protecting SEMANTIC-SI2 * (sort BStore to BStoreS)
							* (sort IStore to IStoreS)
							* (sort RStore to RStoreS)
							* (sort Store to StoreS)
							* (op eval to evalS)
							* (op bresolve to bresolveS)
							* (op iresolve to iresolveS)
							* (op rresolve to rresolveS) .
endm

mod CONCOLIC-SEM is
	protecting SEMANTIC-SI1 .
	protecting SEMANTIC-SI2' .	
endm

