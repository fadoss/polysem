mod SEMANTIC-SI1 is
	*** R: Instantiate SEMANTIC-RULES with SI1 to get concrete eval and IValC. Similar to S_{fw,c} + R_c
	including SEMANTIC-RULES{SI1} .
	
	*** Extiende ecuacionalmente la función de evaluación
	
	eq eval(bref(R:Reference), S:State) = bresolve(R:Reference, S:State) .
	eq eval(iref(R:Reference), S:State) = iresolve(R:Reference, S:State) .

endm

***view evalMetaCheck from 

mod SEMANTIC-SI2 is
	*** SMT semantic instance
	including SEMANTIC-RULES{SI2} .
	***protecting META-LEVEL .
	
	*** Extiende ecuacionalmente la función de evaluación
	
	eq eval(bref(R:Reference), S:State) = bresolve(R:Reference, S:State) .
	eq eval(iref(R:Reference), S:State) = iresolve(R:Reference, S:State) .

endm

mod SEMANTIC-SI3 is
	*** SMT semantic instance
	including SEMANTIC-RULES{SI3} .
	
	*** Extiende ecuacionalmente la función de evaluación
	
	eq eval(bref(R:Reference), S:State) = bresolve(R:Reference, S:State) .
	eq eval(iref(R:Reference), S:State) = iresolve(R:Reference, S:State) .

endm

